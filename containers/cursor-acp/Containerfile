# Engineering OS — Cursor ACP runtime image (EOS-10)
# DEFINITION + reproducible Owner build workflow.
# Do not build during automated increments.
#
# Goals:
# - Reproducible Cursor CLI ACP entrypoint inside rootless Podman
# - Non-root identity, read-only rootfs compatible
# - No embedded credentials, no auto-update
# - Pinned base image digest (Owner must pass BASE_IMAGE=@sha256:...)
#
# Cursor CLI distribution:
#   Documented installer: https://cursor.com/install
#   Docs: https://cursor.com/docs/cli/installation
#   ACP:  https://cursor.com/docs/cli/acp
# No immutable official release tarball with published checksums is documented.
# Owner must capture local binary version + sha256 after install and record
# evidence via `eos cursor image verify --write-evidence`.

ARG BASE_IMAGE=docker.io/library/debian:bookworm-slim
FROM ${BASE_IMAGE}

LABEL org.engineering-os.component="cursor-acp-runtime" \
      org.engineering-os.increment="EOS-10" \
      org.engineering-os.note="Not the Alpine synthetic fixture image"

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/runtime/home \
    XDG_CACHE_HOME=/runtime/cache \
    XDG_CONFIG_HOME=/runtime/config \
    CURSOR_DISABLE_AUTO_UPDATE=1 \
    PATH=/usr/local/bin:/usr/bin:/bin

# Minimal writable runtime dirs for a read-only rootfs launch profile.
RUN mkdir -p /runtime/home /runtime/cache /runtime/config /runtime/tmp /workspace \
    && chmod 755 /runtime /workspace \
    && chown -R 65534:65534 /runtime /workspace

# --- Owner-controlled Cursor CLI install stage (uncomment and pin during build) ---
# The automated EOS-10 tests never execute this. Example Owner steps:
#   1. podman pull debian@sha256:<PINNED>
#   2. Install Cursor CLI from https://cursor.com/install into a build context
#      directory (e.g. ./vendor/cursor-agent) and record sha256sum + version
#   3. COPY vendor/cursor-agent /usr/local/bin/agent
#   4. RUN chmod 755 /usr/local/bin/agent && ln -sf agent /usr/local/bin/cursor-agent
#   5. Verify: agent --version (offline) and record evidence
#
# COPY vendor/cursor-agent /usr/local/bin/agent
# RUN chmod 755 /usr/local/bin/agent \
#     && ln -sf /usr/local/bin/agent /usr/local/bin/cursor-agent \
#     && test -x /usr/local/bin/agent

USER 65534:65534
WORKDIR /workspace

# Default ACP entrypoint candidates (resolved by Engineering OS image profile):
#   agent acp
#   cursor-agent acp
CMD ["agent", "acp"]
