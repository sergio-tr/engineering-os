{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-os:contracts:approval-contract:0.1.0",
  "title": "ApprovalContract",
  "description": "Engineering OS-owned contract for a scoped, auditable human decision. An approval is valid only after independent identity, authorization, scope, expiry, and replay checks by an enforcement component. This schema cannot perform those checks and cannot bypass sandbox or human-only merge rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contract_version",
    "approval_id",
    "project_id",
    "requested_action",
    "scope",
    "requester",
    "approver",
    "decision",
    "created_at",
    "expires_at",
    "correlation_id",
    "constraints"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "ApprovalContract"
    },
    "contract_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^appr-[a-z0-9-]{8,64}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]{2}$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^exec-[a-z0-9-]{8,64}$"
    },
    "requested_action": {
      "type": "string",
      "enum": [
        "authorize_execution",
        "enable_network_exception",
        "authorize_dependency_install",
        "authorize_spend",
        "authorize_privilege_escalation",
        "approve_merge_request_review"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "allowed_paths", "forbidden_actions"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "git_merge",
              "bypass_sandbox",
              "cross_project_access",
              "secret_exfiltration",
              "host_config_change"
            ]
          }
        }
      }
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["agent", "architect", "system"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "human"
        },
        "id": {
          "type": "string",
          "description": "Logical human approver reference. Not a credential.",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "expired", "revoked"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^corr-[a-z0-9-]{8,64}$"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox_still_required",
        "human_merge_still_required",
        "does_not_grant_technical_access"
      ],
      "properties": {
        "sandbox_still_required": {
          "type": "boolean",
          "const": true
        },
        "human_merge_still_required": {
          "type": "boolean",
          "const": true
        },
        "does_not_grant_technical_access": {
          "type": "boolean",
          "const": true,
          "description": "Approval records do not themselves grant technical access."
        }
      }
    }
  }
}
