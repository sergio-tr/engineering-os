{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-os:contracts:agent-profile:0.1.0",
  "title": "AgentProfile",
  "description": "Engineering OS-owned contract describing a logical engineering agent role and declared capabilities. An AgentProfile does not create a running process, operating-system identity, credential, or sandbox.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contract_version",
    "agent_id",
    "role_id",
    "assigned_project_ids",
    "capabilities",
    "tool_access",
    "model_selection_policy",
    "human_escalation"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "AgentProfile"
    },
    "contract_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "assigned_project_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{1,63}$"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read_code",
          "edit_code",
          "run_tests",
          "propose_pr_text",
          "summarize_evidence",
          "request_approval"
        ]
      }
    },
    "tool_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "denied"],
      "properties": {
        "requested": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "filesystem_within_scope",
              "test_runner",
              "git_read",
              "git_write",
              "network",
              "package_install",
              "host_config"
            ]
          }
        },
        "denied": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "filesystem_within_scope",
              "test_runner",
              "git_read",
              "git_write",
              "network",
              "package_install",
              "host_config"
            ]
          }
        }
      }
    },
    "model_selection_policy": {
      "type": "object",
      "description": "Provider-agnostic model selection policy. Do not invent provider-specific model identifiers.",
      "additionalProperties": false,
      "required": ["selection_mode", "requires_owner_approval_for_paid_usage"],
      "properties": {
        "selection_mode": {
          "type": "string",
          "enum": ["owner_configured", "task_declared", "deferred"]
        },
        "requires_owner_approval_for_paid_usage": {
          "type": "boolean",
          "const": true
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "human_escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for"],
      "properties": {
        "required_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "secret_access",
              "network_enablement",
              "dependency_install",
              "git_write",
              "privilege_escalation",
              "cross_project_access",
              "spend_authorization",
              "merge"
            ]
          }
        }
      }
    }
  }
}
